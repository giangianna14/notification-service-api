# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production

# ─── Email (SMTP / Gmail) ─────────────────────────────────────────────────────
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# ─── WhatsApp (Twilio) ────────────────────────────────────────────────────────
# Leave blank to run in mock mode (no Twilio account needed)
# Register: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default = Twilio WhatsApp sandbox number (dev only)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
